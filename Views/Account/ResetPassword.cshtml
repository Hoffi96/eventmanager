@{
    ViewData["Title"] = "Passwort zurücksetzen";
    var token = ViewBag.Token as string;
}
<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-body">
        <h4 class="card-title mb-3">Neues Passwort setzen</h4>
        <form method="post" action="/Account/ResetPassword">
          @Html.AntiForgeryToken()
          <input type="hidden" name="token" value="@token" />
          <div class="mb-3">
            <label class="form-label">Neues Passwort</label>
            <input type="password" name="newPassword" class="form-control" required autofocus>
          </div>
          <div class="mb-3">
            <label class="form-label">Neues Passwort wiederholen</label>
            <input type="password" name="newPassword2" class="form-control" required>
          </div>
          <button type="submit" class="btn btn-primary w-100">Passwort setzen</button>
        </form>
      </div>
    </div>
  </div>
</div>
