<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Helfer-Tasks</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background:#f6f7f9; }
        .navbar-brand { font-weight: 600; }
        .badge-slots-free { font-size: .85rem; }
        .card-task { transition: box-shadow .15s; }
        .card-task:hover { box-shadow: 0 .25rem .75rem rgba(0,0,0,.08); }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="/">🎪 Helfer-Tasks</a>
        <div class="d-flex gap-2 align-items-center flex-wrap justify-content-end">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                var roleSuffix = User.IsInRole("Admin") ? " (Admin)" : User.IsInRole("EventCoordinator") ? " (Koordination)" : "";
                <a href="/Events" class="btn btn-sm btn-outline-light">Veranstaltungen</a>
                <a href="/Tasks" class="btn btn-sm btn-outline-light">Tasks</a>
                <a href="/Tasks/Schedule" class="btn btn-sm btn-outline-light">Zeitplan</a>
                if (User.IsInRole("Admin") || User.IsInRole("EventCoordinator"))
                {
                    <a href="/Admin/Users" class="btn btn-sm btn-outline-light">Nutzer</a>
                }
                if (User.IsInRole("Admin"))
                {
                    <a href="/Tasks/New" class="btn btn-sm btn-success">+ Task anlegen</a>
                    <a href="/Admin/Settings" class="btn btn-sm btn-outline-light">Einstellungen</a>
                }
                <span class="text-light small">
                    Eingeloggt als <strong>@User.Identity.Name</strong>@roleSuffix
                </span>
                <a href="/Account/Profile" class="btn btn-sm btn-outline-light">Profil</a>
                <a href="/Account/ChangePassword" class="btn btn-sm btn-outline-light">Passwort</a>
                <form method="post" action="/Account/Logout" class="d-inline m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
                </form>
            }
            else
            {
                <a href="/Account/Login" class="btn btn-sm btn-outline-light">Login</a>
                <a href="/Account/Register" class="btn btn-sm btn-light">Registrieren</a>
            }
        </div>
    </div>
</nav>

<div class="container pb-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @RenderBody()
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
