@model List<TaskListItemVm>
@{
    ViewData["Title"] = "Tasks";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-0">Task-Übersicht</h2>
        <div class="text-muted">Alle geplanten Einsätze mit Status, freien Plätzen und Warteliste.</div>
    </div>
    <a class="btn btn-outline-secondary" href="/Tasks/Schedule">Zeitplanansicht</a>
</div>

<div class="row g-3">
@foreach (var item in Model)
{
    <div class="col-lg-6">
        <div class="card card-task shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                    <div>
                        <h4 class="mb-1"><a class="text-decoration-none" href="/Tasks/Details/@item.Task.Id">@item.Task.Title</a></h4>
                        <div class="text-muted small">@item.Task.Event.Name</div>
                        <div class="text-muted small">@item.Task.StartsAt.ToString("dd.MM.yyyy HH:mm") - @item.Task.EndsAt.ToString("HH:mm")</div>
                    </div>
                    <span class="badge @(item.SlotsFree > 0 ? "bg-success" : "bg-danger") badge-slots-free">frei: @item.SlotsFree</span>
                </div>

                <div class="mb-2 d-flex gap-2 flex-wrap">
                    <span class="badge bg-secondary">Zugeordnet: @item.Assignees.Count / @item.Task.MaxAssignees</span>
                    <span class="badge bg-warning text-dark">Warteliste: @item.WaitlistCount</span>
                    @if (item.IsAssigned)
                    {
                        <span class="badge bg-primary">Du bist eingetragen</span>
                    }
                    else if (item.IsOnWaitlist)
                    {
                        <span class="badge bg-warning text-dark">Du bist auf der Warteliste</span>
                    }
                </div>

                <div class="small text-muted mb-3">
                    Helfende: @(item.Assignees.Any() ? string.Join(", ", item.Assignees.Select(a => a.Username)) : "Noch niemand")
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-sm btn-outline-primary" href="/Tasks/Details/@item.Task.Id">Details</a>
                    @if (item.IsAssigned)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="/Tasks/Ics/@item.Task.Id">ICS</a>
                    }
                </div>
            </div>
        </div>
    </div>
}
</div>
