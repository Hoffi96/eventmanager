# systemd-Unit für den produktiven Betrieb unter Linux.
# Installation: siehe deploy/README.md
[Unit]
Description=Helfer-Tasks (ASP.NET Core)
After=network.target

[Service]
WorkingDirectory=/var/www/helferapp
ExecStart=/usr/bin/dotnet /var/www/helferapp/HelferApp.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=helferapp
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
# Falls die SQLite-Datei woanders liegen soll, hier per ConnectionStrings__Default
# oder direkt in appsettings.Production.json anpassen.

[Install]
WantedBy=multi-user.target
